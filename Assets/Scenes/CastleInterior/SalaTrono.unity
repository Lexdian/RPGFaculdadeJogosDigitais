    - target: {fileID: 4058524045343842628, guid: 92cb67c59f8c5b24a8c939e7b8bfdd10, type: 3}
      propertyPath: 'dialog.Array.data[1]'
      value: "Ou\xE7am-me bem: o destino de Kran n\xE3o morre com este castelo. Encontrem
        o Pr\xEDncipe e os sobreviventes e os tirem daqui. Saiam de Kran-Tor agora!
        Protejam o futuro do nosso povo... V\xC3O!"
      objectReference: {fileID: 0}
